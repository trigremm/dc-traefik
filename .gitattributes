# Default text behaviour, LF in working tree
* text=auto eol=lf

# Binary files
*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,tar,tgz,gz,7z} binary

# Force LF for configs and scripts
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.mk   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
